{
  "manifest_version": 3,
  "name": "dLux Open New Tab To The Right",
  "version": "1.1.0",
  "description": "New tabs open to the right of your current tab. Optional: newest link click always next to the current tab.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "spanning"
}
